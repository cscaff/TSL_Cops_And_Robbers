always assume {
G ( ( (gt Cop.x Robber.x) && ([Cop.x <- sub Cop.x int1()])  W (lt Cop.x Robber.x) ) -> F ((lt Cop.x Robber.x)) ) ;
G ( ( (gt Cop.x Robber.x) && ([Cop.x <- sub Cop.x int1()])  W (eq Robber.x Cop.x) ) -> F ((eq Robber.x Cop.x)) ) ;
G ( ( (gt Cop.x Robber.x) && ([Cop.x <- sub Cop.x int1()])  W (eq Cop.x Robber.x) ) -> F ((eq Cop.x Robber.x)) ) ;
G ( ( (lt Cop.x Robber.x) && ([Cop.x <- add Cop.x int1()])  W (gt Cop.x Robber.x) ) -> F ((gt Cop.x Robber.x)) ) ;
G ( ( (lt Cop.x Robber.x) && ([Cop.x <- add Cop.x int1()])  W (eq Robber.x Cop.x) ) -> F ((eq Robber.x Cop.x)) ) ;
G ( ( (lt Cop.x Robber.x) && ([Cop.x <- add Cop.x int1()])  W (eq Cop.x Robber.x) ) -> F ((eq Cop.x Robber.x)) ) ;
G ( ( (gt Cop.y Robber.y) && ([Cop.y <- sub Cop.y int1()])  W (lt Cop.y Robber.y) ) -> F ((lt Cop.y Robber.y)) ) ;
G ( ( (gt Cop.y Robber.y) && ([Cop.y <- sub Cop.y int1()])  W (eq Robber.y Cop.y) ) -> F ((eq Robber.y Cop.y)) ) ;
G ( ( (gt Cop.y Robber.y) && ([Cop.y <- sub Cop.y int1()])  W (eq Cop.y Robber.y) ) -> F ((eq Cop.y Robber.y)) ) ;
G ( ( (lt Cop.y Robber.y) && ([Cop.y <- add Cop.y int1()])  W (gt Cop.y Robber.y) ) -> F ((gt Cop.y Robber.y)) ) ;
G ( ( (lt Cop.y Robber.y) && ([Cop.y <- add Cop.y int1()])  W (eq Robber.y Cop.y) ) -> F ((eq Robber.y Cop.y)) ) ;
G ( ( (lt Cop.y Robber.y) && ([Cop.y <- add Cop.y int1()])  W (eq Cop.y Robber.y) ) -> F ((eq Cop.y Robber.y)) ) ;
G ( ( (eq Robber.y Cop.y) && ([Cop.y <- add Cop.y int1()])  ) -> X ((gt Cop.y Robber.y)) ) ;
G ( ( (eq Robber.y Cop.y) && ([Cop.y <- add Cop.y int1()])  W (gt Cop.y Robber.y) ) -> F ((gt Cop.y Robber.y)) ) ;
G ( ( (eq Robber.y Cop.y) && ([Cop.y <- sub Cop.y int1()])  ) -> X ((lt Cop.y Robber.y)) ) ;
G ( ( (eq Robber.y Cop.y) && ([Cop.y <- sub Cop.y int1()])  W (lt Cop.y Robber.y) ) -> F ((lt Cop.y Robber.y)) ) ;
G ( ( (eq Robber.x Cop.x) && ([Cop.x <- add Cop.x int1()])  ) -> X ((gt Cop.x Robber.x)) ) ;
G ( ( (eq Robber.x Cop.x) && ([Cop.x <- add Cop.x int1()])  W (gt Cop.x Robber.x) ) -> F ((gt Cop.x Robber.x)) ) ;
G ( ( (eq Robber.x Cop.x) && ([Cop.x <- sub Cop.x int1()])  ) -> X ((lt Cop.x Robber.x)) ) ;
G ( ( (eq Robber.x Cop.x) && ([Cop.x <- sub Cop.x int1()])  W (lt Cop.x Robber.x) ) -> F ((lt Cop.x Robber.x)) ) ;
G ( ( (eq Cop.y Robber.y) && ([Cop.y <- add Cop.y int1()])  ) -> X ((gt Cop.y Robber.y)) ) ;
G ( ( (eq Cop.y Robber.y) && ([Cop.y <- add Cop.y int1()])  W (gt Cop.y Robber.y) ) -> F ((gt Cop.y Robber.y)) ) ;
G ( ( (eq Cop.y Robber.y) && ([Cop.y <- sub Cop.y int1()])  ) -> X ((lt Cop.y Robber.y)) ) ;
G ( ( (eq Cop.y Robber.y) && ([Cop.y <- sub Cop.y int1()])  W (lt Cop.y Robber.y) ) -> F ((lt Cop.y Robber.y)) ) ;
G ( ( (eq Cop.x Robber.x) && ([Cop.x <- add Cop.x int1()])  ) -> X ((gt Cop.x Robber.x)) ) ;
G ( ( (eq Cop.x Robber.x) && ([Cop.x <- add Cop.x int1()])  W (gt Cop.x Robber.x) ) -> F ((gt Cop.x Robber.x)) ) ;
G ( ( (eq Cop.x Robber.x) && ([Cop.x <- sub Cop.x int1()])  ) -> X ((lt Cop.x Robber.x)) ) ;
G ( ( (eq Cop.x Robber.x) && ([Cop.x <- sub Cop.x int1()])  W (lt Cop.x Robber.x) ) -> F ((lt Cop.x Robber.x)) ) ;

}
initially assume {

}

always assume {
(eq minX int0());
(eq maxX int2());
(eq MinY int0());
(eq MaxY int2());
(lt MinX MaxX);
(lt MinY MaxY);
((lte Robber.x MaxX) && (gte Robber.x MinX));
((lte Robber.y MaxY) && (gte Robber.y MinY));
(! ((lt Cop.x Robber.x) && (gt Cop.x Robber.x)));
(! ((lt Cop.y Robber.y) && (gt Cop.y Robber.y)));
((eq Robber.x int0()) && (eq Robber.y int0()));
(((eq Robber.x Cop.x) && (eq Robber.y Cop.y)) -> (G ((Robber.stayX) && (Robber.stayY))));

}

always guarantee {
((gte Cop.x MinX) && (lte Cop.x MaxX));
((gte Cop.y MinY) && (lte Cop.y MaxY));
((((Cop.moveL) || (Cop.moveR)) || (Cop.stayX)) && (((Cop.moveU) || (Cop.moveD)) || (Cop.stayY)));
((! ((Cop.moveL) && (Cop.moveR))) && (! ((Cop.moveU) && (Cop.moveD))));
((! ((Cop.moveL) && (Cop.stayX))) && (! ((Cop.moveR) && (Cop.stayX))));
((! ((Cop.moveU) && (Cop.stayY))) && (! ((Cop.moveD) && (Cop.stayY))));
((Cop.moveL) -> (X [Cop.x <- (sub Cop.x int1())]));
((Cop.moveR) -> (X [Cop.x <- (add Cop.x int1())]));
((Cop.moveU) -> (X [Cop.y <- (sub Cop.y int1())]));
((Cop.moveD) -> (X [Cop.y <- (add Cop.y int1())]));
((Cop.stayX) -> (X [Cop.x <- Cop.x]));
((Cop.stayY) -> (X [Cop.y <- Cop.y]));
(F ((eq Cop.x Robber.x) && (eq Cop.y Robber.y)));

}

