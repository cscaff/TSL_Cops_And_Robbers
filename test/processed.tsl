initially assume {

}

always assume {
(lt MinX() MaxX());
(lt MinY() MaxY());
((lte Cop.x MaxX()) && (gte Cop.x MinX()));
((lte Cop.y MaxY()) && (gte Cop.y MinY()));
((lte Robber.x MaxX()) && (gte Robber.x MinX()));
((lte Robber.y MaxY()) && (gte Robber.y MinY()));
(! ((lt Cop.x Robber.x) && (gt Cop.x Robber.x)));
(! ((lt Cop.y Robber.y) && (gt Cop.y Robber.y)));
((X (eq Robber.x (add Robber.x int1()))) || (X (eq Robber.x (sub Robber.x int1()))));
((X (eq Robber.y (add Robber.y int1()))) || (X (eq Robber.y (sub Robber.y int1()))));

}

always guarantee {
([Cop.x <- MaxX()] -> [Cop.x <- (Cop.moveL Cop.x)]);
([Cop.x <- MinX()] -> [Cop.x <- (Cop.moveR Cop.x)]);
([Cop.y <- MaxY()] -> [Cop.y <- (Cop.moveU Cop.x)]);
([Cop.y <- MinY()] -> [Cop.y <- (Cop.moveD Cop.x)]);
((! (eq Cop.x Robber.x)) -> ((X [Cop.x <- (Cop.moveR Cop.x)]) || (X [Cop.x <- (Cop.moveL Cop.x)])));
((! (eq Cop.y Robber.y)) -> ((X [Cop.y <- (Cop.moveU Cop.y)]) || (X [Cop.y <- (Cop.moveD Cop.y)])));
(F ((eq Cop.x Robber.x) && (eq Cop.y Robber.y)));

}

